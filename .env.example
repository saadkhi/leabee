# Copy to .env and fill in. NEVER commit .env.
TINYFISH_API_KEY=
# Optional: contact string sent in the User-Agent
LEABEE_CONTACT=
# Your name for the reply drafts
LEABEE_YOUR_NAME=

# Optional AI second opinion on borderline leads (python -m leabee ai-review)
ANTHROPIC_API_KEY=
# Optional: higher GitHub search limits
GITHUB_TOKEN=

# Optional dashboard password (HTTP Basic, any username). Set this before exposing the app online.
LEABEE_PASSWORD=

# Optional alerts for new hot leads (any one is enough)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
