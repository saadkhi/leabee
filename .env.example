# Copy to .env and fill in. NEVER commit .env.
TINYFISH_API_KEY=
# Optional: contact string sent in the User-Agent
LEABEE_CONTACT=
# Your name for the reply drafts
LEABEE_YOUR_NAME=

# Optional AI second opinion on borderline leads (python -m leabee ai-review)
OPENROUTER_API_KEY=
# Fully local and free alternative to OpenRouter (Ollama): set these two instead, no key needed
LEABEE_LLM_BASE_URL=
LEABEE_LLM_MODEL=
# Optional: higher GitHub search limits
GITHUB_TOKEN=

# Optional dashboard password (HTTP Basic, any username). Set this before exposing the app online.
LEABEE_PASSWORD=

# Optional alerts for new hot leads (any one is enough)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Hosted database (Neon Postgres). When set, every command and the web app share this one database.
# Use Neon's pooled connection string (host contains "-pooler"): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=
# Vercel dashboard: lets the Collect button start the GitHub Actions workflow
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=
